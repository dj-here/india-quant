{
  "name": "pawstay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade two-sided marketplace for pet care",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "test:unit": "vitest run packages/shared",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @pawstay/db generate",
    "db:push": "pnpm --filter @pawstay/db push",
    "db:migrate": "pnpm --filter @pawstay/db migrate",
    "db:seed": "pnpm --filter @pawstay/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "pnpm --recursive exec rm -rf node_modules .turbo dist .next",
    "postinstall": "node scripts/patch-next-node.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@12.15.0"
}
