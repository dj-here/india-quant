datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CollegeLead {
  id                 String    @id @default(cuid())
  collegeName        String
  city               String
  state              String
  contactPerson      String
  role               String
  email              String
  phone              String
  studentStrength    Int
  targetYears        String
  targetBranches     String
  interestedPrograms String
  preferredMode      String    @default("ON_CAMPUS")
  message            String?
  status             String    @default("NEW")
  notes              String?
  followUpDate       DateTime?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([state])
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  section       String   // "QUANT", "LOGICAL", "VERBAL", "DSA_BASIC"
  subTopic      String
  difficulty    String   @default("MEDIUM")
  questionText  String
  codeSnippet   String?
  options       String
  correctAnswer Int
  explanation   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([section])
  @@index([difficulty])
}

model AssessmentSubmission {
  id               String   @id @default(cuid())
  studentName      String
  studentEmail     String
  studentPhone     String
  collegeName      String
  branch           String
  graduationYear   Int
  totalScore       Int
  percentage       Float
  quantScore       Int
  logicalScore     Int
  verbalScore      Int
  dsaScore         Int
  timeTakenSeconds Int
  readinessBand    String
  answersJson      String
  createdAt        DateTime @default(now())

  @@index([collegeName])
  @@index([readinessBand])
}

model Testimonial {
  id           String   @id @default(cuid())
  authorName   String
  designation  String
  collegeName  String
  city         String
  quote        String
  rating       Int      @default(5)
  authorAvatar String?
  isFeatured   Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String   @default("GENERAL")
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}
