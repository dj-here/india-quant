{
  "name": "@pawstay/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background jobs worker for PawStay (BullMQ + Redis)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
