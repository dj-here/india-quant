{
  "name": "@pawstay/web",
  "version": "1.0.0",
  "private": true,
  "description": "PawStay Web Application (Next.js 14 App Router)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "cd ../.. && pnpm --filter @pawstay/shared build && pnpm --filter @pawstay/db generate && pnpm --filter @pawstay/db build && cd apps/web && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pawstay/db": "workspace:*",
    "@pawstay/shared": "workspace:*",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.344.0",
    "next": "14.1.4",
    "next-auth": "^4.24.7",
    "pino": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pawstay/config": "workspace:*",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.3.3"
  }
}
