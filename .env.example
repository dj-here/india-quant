# ==============================================================================
# PawStay Environment Configuration Reference (.env.example)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=PawStay
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL 15+ connection with PostGIS extensions
DATABASE_URL="postgresql://pawstay_admin:pawstay_secure_password@localhost:5432/pawstay_dev?schema=public"
# Direct URL for Prisma migrations when using connection poolers like PgBouncer
DIRECT_URL="postgresql://pawstay_admin:pawstay_secure_password@localhost:5432/pawstay_dev?schema=public"

# Redis connection for BullMQ queues, rate limiting, and cache
REDIS_URL="redis://:pawstay_redis_secret@localhost:6379"

# ------------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# 32+ character random secret (openssl rand -base64 32)
NEXTAUTH_SECRET=super_secret_pawstay_jwt_session_token_min_32_chars!
# Google OAuth provider
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# ------------------------------------------------------------------------------
# Payments & Marketplace (Stripe Connect Express)
# ------------------------------------------------------------------------------
# Provider switch: 'stripe' | 'mock'
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForPawStayDevelopmentOnly
STRIPE_PUBLISHABLE_KEY=pk_test_51MockStripePublishableKeyForPawStay
STRIPE_WEBHOOK_SECRET=whsec_mockStripeWebhookSigningSecret12345
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_mockStripeConnectWebhookSigningSecret12345
DEFAULT_CURRENCY=USD

# Platform fee rates (admin-configurable defaults)
DEFAULT_OWNER_SERVICE_FEE_BPS=700   # 7.00% (basis points)
DEFAULT_SITTER_COMMISSION_BPS=1200  # 12.00% (basis points)

# ------------------------------------------------------------------------------
# File Storage (S3 / MinIO compatible)
# ------------------------------------------------------------------------------
# Provider switch: 's3' | 'minio' | 'local'
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=pawstay-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_CDN_URL=http://localhost:9000/pawstay-media

# ------------------------------------------------------------------------------
# Realtime Messaging (Ably / Pusher / Local)
# ------------------------------------------------------------------------------
# Provider switch: 'pusher' | 'ably' | 'mock'
REALTIME_PROVIDER=mock
PUSHER_APP_ID=mock_pusher_id
PUSHER_KEY=mock_pusher_key
PUSHER_SECRET=mock_pusher_secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=mock_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ------------------------------------------------------------------------------
# Email Notifications (Resend / SES / MailHog)
# ------------------------------------------------------------------------------
# Provider switch: 'resend' | 'mailhog' | 'mock'
EMAIL_PROVIDER=mailhog
RESEND_API_KEY=re_mock_resend_api_key_123
EMAIL_FROM="PawStay <care@pawstay.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# ------------------------------------------------------------------------------
# SMS / WhatsApp Notifications (Twilio / Mock)
# ------------------------------------------------------------------------------
# Provider switch: 'twilio' | 'mock'
NOTIFIER_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER="+15551234567"

# ------------------------------------------------------------------------------
# Geocoding & Maps (Mapbox / Google Maps / Mock)
# ------------------------------------------------------------------------------
# Provider switch: 'mapbox' | 'google' | 'mock'
GEO_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=pk.mock_mapbox_token_for_pawstay_dev
NEXT_PUBLIC_MAPBOX_TOKEN=pk.mock_mapbox_token_for_pawstay_dev
GOOGLE_MAPS_API_KEY=mock_google_maps_key

# ------------------------------------------------------------------------------
# Identity Verification & Background Check
# ------------------------------------------------------------------------------
# Provider switch: 'stripe_identity' | 'persona' | 'mock'
IDENTITY_VERIFIER_PROVIDER=mock
STRIPE_IDENTITY_KEY=sk_test_mock_identity
PERSONA_API_KEY=persona_sandbox_mock
BACKGROUND_CHECK_PROVIDER=mock
CHECKR_API_KEY=mock_checkr_key

# ------------------------------------------------------------------------------
# Observability & Security (Sentry, OpenTelemetry, Turnstile)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
