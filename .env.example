# ==============================================================================
# KidsMentor — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database
# For production: postgresql+asyncpg://<username>:<password>@<rds-host>:5432/kidsmentor
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kidsmentor
REDIS_URL=redis://localhost:6379/0

# Security & JWT Auth
SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Models & Providers (Anthropic Claude default per ADR-001/ADR-010)
PRIMARY_LLM_PROVIDER=anthropic
FALLBACK_LLM_PROVIDER=gemini
TUTOR_MODEL_ID=claude-3-5-sonnet-20241022
CLASSIFIER_MODEL_ID=claude-3-5-haiku-20241022
VALUES_MODEL_ID=claude-3-5-sonnet-20241022
ASSESSOR_MODEL_ID=claude-3-5-haiku-20241022

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Safety & Global Kill Switches
KILL_SWITCH_AI_ALL=false
KILL_SWITCH_VOICE=false
KILL_SWITCH_VISION=false
EMERGENCY_HELPLINE_INDIA=1098

# Frontend URL
NEXT_PUBLIC_API_URL=https://api.kidsmentor.app
NEXT_PUBLIC_APP_URL=https://kidsmentor.app
