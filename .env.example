# Neon Serverless PostgreSQL
# Use pooled connection string (-pooler) for runtime serverless functions
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-gentle-water-b3rnxxt7-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for migrations via drizzle-kit
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-gentle-water-b3rnxxt7.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Cryptographic token signing secret (minimum 32 characters)
