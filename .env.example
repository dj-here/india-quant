# ==============================================================================
# CampusEdge Learning Solutions - Environment Configuration Example
# ==============================================================================

NODE_ENV=production
APP_NAME=CampusEdge
NEXT_PUBLIC_APP_URL=https://campusedge.in
NEXT_PUBLIC_API_URL=https://campusedge.in/api
PORT=3000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Neon / Supabase / AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-sample-1234.us-east-2.aws.neon.tech/campusedge?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION (Admin Dashboard Protection)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://campusedge.in
NEXTAUTH_SECRET=generate_a_random_32_character_string_here_for_jwt_signing

# Seed Admin Credentials
ADMIN_DEFAULT_EMAIL=admin@campusedge.in
ADMIN_DEFAULT_PASSWORD=ChangeThisPasswordInProduction2026!

# ------------------------------------------------------------------------------
# 3. PUBLIC BRAND & CONTACT DETAILS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="CampusEdge Learning Solutions"
NEXT_PUBLIC_CONTACT_EMAIL="partnerships@campusedge.in"
NEXT_PUBLIC_CONTACT_PHONE="+91 98201 44550"
NEXT_PUBLIC_WHATSAPP_NUMBER="919820144550"

# Notification Recipient (Receives inbound TPO lead alerts)
NOTIFICATION_EMAIL="partnerships@campusedge.in"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL DELIVERY (Resend / SMTP)
# ------------------------------------------------------------------------------
# If RESEND_API_KEY is provided, Resend API is preferred.
# Otherwise, standard SMTP (Gmail, AWS SES, Brevo, SendGrid) is used.
RESEND_API_KEY=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="partnerships@campusedge.in"
SMTP_PASSWORD="app_specific_password_here"
SMTP_FROM="CampusEdge Partnerships <partnerships@campusedge.in>"

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=600000
MAX_REQUESTS_PER_WINDOW=5
