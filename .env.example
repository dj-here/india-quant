# ==============================================================================
# IndiaQuant Platform Environment Configuration
# Copy this file to .env and populate your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Core Application Settings
APP_ENV=development                       # development | staging | production
APP_NAME=IndiaQuant
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
DEBUG=true

# Storage & Lakehouse
DATA_LAKE_PATH=./data/lake                # Local Parquet lakehouse root
PARQUET_COMPRESSION=snappy                # snappy | zstd | gzip
AWS_REGION=ap-south-1                     # AWS Mumbai
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DATA_BUCKET=india-quant-datalake-mumbai

# TimescaleDB / PostgreSQL Time-Series Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=india_quant
DB_PASSWORD=india_quant_secure_pass
DB_NAME=india_quant_tsdb
DB_SSL_MODE=disable

# Neon Serverless PostgreSQL (Cloud Production)
# Get your connection string from https://console.neon.tech
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Vercel Serverless Deployment
VERCEL_ENV=production

# Redis Hot Cache & Feature Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Primary Execution Broker: Zerodha Kite Connect v3
KITE_API_KEY=your_zerodha_api_key_here
KITE_API_SECRET=your_zerodha_api_secret_here
KITE_ACCESS_TOKEN=your_daily_access_token_here
KITE_USER_ID=your_kite_user_id

# Secondary / Fallback Broker: Dhan HQ v2
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Fallback & Macro Data Feeds
FRED_API_KEY=                             # Federal Reserve Economic Data (US 10Y, DXY)
NEWS_API_KEY=                             # Financial news sentiment feeds

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=IndiaQuant-Direction-Range

# Serving API & Security
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=generate_a_random_32_byte_secret_for_jwt_auth_here
API_RATE_LIMIT_PER_MINUTE=120

# Alerting Gateways
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety & Execution Gating (STRICT RISK CONTROLS)
ENABLE_LIVE_ORDERS=false                  # Must be explicitly true for broker order execution
PAPER_TRADING_INITIAL_CAPITAL=1000000     # ₹10,00,000 INR starting capital for paper engine
MAX_PORTFOLIO_DRAWDOWN_LIMIT=0.15         # 15% Max DD hard liquidation kill switch
ANNUAL_TARGET_VOLATILITY=0.14             # 14% target annualized volatility
